  "info": {
    "_postman_id": "8a57dae9-2a15-4bcb-bbc4-54ee8258fbd2",
    "name": "Microsoft Exchange Exchange Online Admin Accepted Domains Mailbox Export API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST-based administrative API that enables a focused set of Exchange cmdlets and parameters as POST-only endpoints. Provides access to key tasks previously available through Exchange Web Services (EWS), including organization configuration, accepted domains, mailbox properties, mailbox folder permissions, and distribution group membership. Built as a complementary REST-first surface for specific administrative tasks caused by the EWS deprecation planned for October 2026.\n\nContact Support:\n Name: Microsoft Support\n Email: support@microsoft.com",
      "type": "text/plain"
    }
  }
