      },
      "items": [
        {
          "info": {
            "name": "Microsoft Exchange List contact folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://outlook.office365.com/adminapi/v2.0/me/contactFolders",
            "params": [
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "The number of items to return"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "The number of items to skip"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of properties to include"
              }
            ]
          },
          "docs": "Get the contact folder collection in the default contacts folder of the signed-in user."
        },
        {
          "info": {
            "name": "Microsoft Exchange Create contact folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://outlook.office365.com/adminapi/v2.0/me/contactFolders",
            "body": {
              "type": "json",
              "data": "{}"
