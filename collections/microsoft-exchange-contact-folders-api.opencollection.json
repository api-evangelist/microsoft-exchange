          "http": {
            "method": "GET",
            "url": "https://outlook.office365.com/adminapi/v2.0/me/contactFolders/:contactFolder-id/childFolders",
            "params": [
              {
                "name": "contactFolder-id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the contact folder"
