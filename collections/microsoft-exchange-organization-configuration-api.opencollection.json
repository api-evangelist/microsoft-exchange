      "items": [
        {
          "info": {
            "name": "Microsoft Exchange Get organization configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://outlook.office365.com/adminapi/v2.0/OrganizationConfig",
            "headers": [
              {
                "name": "X-AnchorMailbox",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve organization-level Exchange configuration related to MailTips settings. Returns organization settings such as accepted domains, MailTips configuration, and mailbox limits including MaxSendSize. Replaces the GetServiceConfiguration EWS operation."
