            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://outlook.office365.com/adminapi/v2.0/DistributionGroupMember",
            "headers": [
              {
                "name": "X-AnchorMailbox",
                "value": ""
              }
